{
  "name": "tcv-logisuite-erp",
  "version": "1.0.0",
  "description": "TCV LogiSuite ERP - Sistema de gestión logística y de transporte multiempresa",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "mysql -u $DB_USER -p $DB_NAME < backend/database/esquema/init_db.sql",
    "verificar": "node scripts/verificar-requires.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "node --test backend/test/viajes.calculos.test.js backend/test/facturacion.servicio.test.js",
    "test:integracion": "node --test --test-concurrency=1 backend/test/integracion/circuitoCuentas.test.js backend/test/integracion/seguridad.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@afipsdk/afip.js": "^1.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
