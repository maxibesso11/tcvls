# ============================================================
# Configuración del ERP — copiar a .env y completar
#   cp .env.example .env
# El archivo .env vive en la RAÍZ del proyecto y nunca se sube al repositorio.
# ============================================================

# Entorno: development | production
NODE_ENV=production

# --- Servidor ---
# Puerto interno donde escucha Node (Nginx hace el proxy hacia aquí)
PORT=3000
# Host de escucha. 127.0.0.1 si Nginx está en la misma VPS (recomendado);
# 0.0.0.0 si se accede directo sin reverse proxy.
HOST=127.0.0.1

# --- Base de datos MySQL ---
# Con Docker (docker-compose.yml), DB_HOST y DB_PORT se ignoran: la app usa el
# contenedor "db". La base y el usuario se crean solos la primera vez.
DB_HOST=localhost
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=cambiar_por_una_password_fuerte
DB_NAME=erp_3_abril

# --- Docker (solo si se usa docker-compose.yml) ---
# Contraseña de root de MySQL dentro del contenedor (openssl rand -hex 24).
MYSQL_ROOT_PASSWORD=cambiar_por_otra_password_fuerte
# Usuario del servidor con el que corre la app (en el VPS: id -u tcvls / id -g tcvls).
TCV_UID=1000
TCV_GID=1000
# Puerto local donde Nginx encuentra la app (127.0.0.1:APP_PUERTO).
APP_PUERTO=3001
# Imagen en Docker Hub (repositorio privado) y versión desplegada.
# TAG lo actualiza deploy/desplegar.sh; no editarlo a mano.
TCV_IMAGEN=tcvls/tcvls-app
TAG=latest
# Zona horaria de la base y de la app. El servidor histórico usó UTC:
# no cambiarla sin revisar las fechas guardadas.
TZ=UTC

# --- Seguridad (OBLIGATORIAS: sin ellas el sistema no arranca) ---
# Los dos secretos deben tener al menos 32 caracteres, ser distintos entre sí
# y no ser los valores de ejemplo de este archivo.
# Generar cada uno con: openssl rand -hex 48

# Secreto para firmar los tokens de sesión. Si se cambia, todos los usuarios
# vuelven a iniciar sesión (no se pierden datos).
AUTH_SECRET=cambiar_por_una_cadena_larga_y_aleatoria_unica

# Cifrado de las claves privadas de los certificados de facturación (ARCA).
# NO debe cambiarse una vez que hay certificados guardados (si cambia, no se
# podrán descifrar las claves ya almacenadas). Guardalo también fuera del
# servidor y de la base de datos.
CERT_SECRET=generar-un-valor-largo-y-aleatorio-unico-para-certificados

# --- Respaldos (panel de administración) ---
# Carpeta donde el script de respaldo deja los .sql.gz (con Docker, montada en
# la app: ver docker-compose.yml). El panel los lista y permite descargarlos.
RESPALDOS_DIR=/var/backups/tcv-bd

# --- CORS ---
# Dominio(s) permitidos, separados por coma. Usar * solo en desarrollo.
# Ej: https://erp.midominio.com
CORS_ORIGIN=*

# --- Facturación electrónica (comprobantes A, B o C con ARCA, ex-AFIP) ---
# 0 (o ausente): el módulo Facturación no aparece, la API no emite
# comprobantes y los viajes se facturan como siempre (líquido producto o sin
# facturar). 1: se factura con el facturador, pidiendo el CAE a ARCA con el
# certificado de cada empresa (conexión directa, la clave no sale del servidor).
FACTURACION_HABILITADA=0
# Entorno de ARCA: 1 = PRODUCCIÓN (comprobantes reales), vacío/0 = HOMOLOGACIÓN
# (pruebas, sin validez fiscal). El certificado tiene que ser del mismo entorno.
ARCA_PRODUCCION=0
# Tiempo máximo de espera de cada pedido a ARCA, en milisegundos (30000 por defecto).
# ARCA_TIEMPO_LIMITE_MS=30000

# --- Formulario de asesoría de la landing (correo) ---
# ASESORIA_DESTINO: dirección que recibe las solicitudes (no se expone al público).
# Para Gmail se recomienda una "contraseña de aplicación" (no la clave normal).
ASESORIA_DESTINO=destino@ejemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_casilla@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_DESDE=TCV LogiSuite <tu_casilla@gmail.com>
